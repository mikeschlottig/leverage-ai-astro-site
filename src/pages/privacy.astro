---
// ============================================================
// PRIVACY POLICY — Leverage AI LLC
// noIndex: true — legal page, not for search indexing
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | Leverage AI"
  description="Privacy Policy for Leverage AI LLC."
  noIndex={true}
>
  <div style="padding-top: 4.5rem;">
    <section class="section-padding">
      <div class="container-custom" style="max-width: 720px;">

        <h1
          style="
            font-family: var(--font-heading);
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 300;
            margin: 0 0 0.5rem;
            color: var(--text-primary);
          "
        >
          Privacy Policy
        </h1>
        <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 3rem;">
          Last updated: April 2026
        </p>

        <div style="display: flex; flex-direction: column; gap: 2.5rem; color: var(--text-secondary); line-height: 1.8; font-size: 0.95rem;">

          <div>
            <h2
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                color: var(--text-primary);
                margin: 0 0 0.75rem;
              "
            >
              Information We Collect
            </h2>
            <p>
              When you interact with Leverage AI LLC through our website or contact forms, we may collect personal information including your name, email address, company name, and any details you voluntarily provide in your message. We also collect standard web analytics data such as page views, referral sources, browser type, and approximate geographic location via anonymized IP address through privacy-respecting analytics tools.
            </p>
          </div>

          <div>
            <h2
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                color: var(--text-primary);
                margin: 0 0 0.75rem;
              "
            >
              How We Use Your Information
            </h2>
            <p>
              We use the information you provide solely to respond to your inquiries, fulfill service engagements, and communicate relevant updates about your project. We do not sell, rent, or share your personal data with third parties for their own marketing purposes. Analytics data is used in aggregate to improve website performance and user experience.
            </p>
          </div>

          <div>
            <h2
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                color: var(--text-primary);
                margin: 0 0 0.75rem;
              "
            >
              Cookies
            </h2>
            <p>
              This website may use essential cookies required for basic site functionality. We do not use tracking or advertising cookies. Analytics, if implemented, are configured to respect user privacy and do not require cookie consent under applicable frameworks. You can disable cookies in your browser settings without affecting core site functionality.
            </p>
          </div>

          <div>
            <h2
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                color: var(--text-primary);
                margin: 0 0 0.75rem;
              "
            >
              Third-Party Services
            </h2>
            <p>
              We may use third-party services for form processing (such as Formspree) and web analytics. These services have their own privacy policies and data handling practices. Links to external websites are provided for convenience; we are not responsible for the privacy practices of those sites.
            </p>
          </div>

          <div>
            <h2
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                color: var(--text-primary);
                margin: 0 0 0.75rem;
              "
            >
              Data Retention
            </h2>
            <p>
              We retain contact form submissions and client communications only as long as necessary for the purposes they were collected — typically for the duration of an active client relationship plus a reasonable period thereafter for legal and accounting purposes. You may request deletion of your personal data at any time.
            </p>
          </div>

          <div>
            <h2
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                color: var(--text-primary);
                margin: 0 0 0.75rem;
              "
            >
              Your Rights
            </h2>
            <p>
              Depending on your jurisdiction, you may have rights including access to, correction of, and deletion of personal data we hold about you. Oregon residents and EU/UK residents may have additional rights under applicable privacy laws. To exercise any of these rights, please contact us directly.
            </p>
          </div>

          <div>
            <h2
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                color: var(--text-primary);
                margin: 0 0 0.75rem;
              "
            >
              Contact
            </h2>
            <p>
              For privacy questions or data requests, email us at{' '}
              <a href="mailto:hello@leverageai.com" style="color: var(--accent);">hello@leverageai.com</a>.
              We will respond within 30 days.
            </p>
          </div>

        </div>

        <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle);">
          <a href="/" style="font-size: 0.8rem; color: var(--text-muted); text-decoration: none;">&larr; Return Home</a>
        </div>

      </div>
    </section>
  </div>
</BaseLayout>
