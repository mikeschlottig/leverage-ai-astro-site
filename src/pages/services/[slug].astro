---
// ============================================================
// SERVICE DETAIL PAGE — Dynamic route /services/[slug]
//
// Astro v6: uses render(entry) from 'astro:content'
// Schema: Service as a ProfessionalService offering
// ============================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../lib/site-config';
import { Search, Palette, Globe, BarChart3 } from 'lucide-react';

const { slug } = Astro.params;
const services = await getCollection('services');
const entry = services.find((e) => e.data.slug === slug);
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: siteConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteConfig.url}/services` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `${siteConfig.url}/services/${entry.data.slug}` },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.description,
  provider: {
    '@type': 'Organization',
    name:    'Leverage AI LLC',
    url:     siteConfig.url,
  },
  areaServed: 'US',
  url: `${siteConfig.url}/services/${entry.data.slug}`,
};
---

<BaseLayout
  title={`${entry.data.title} | Services — Leverage AI`}
  description={entry.data.description}
  keywords={(entry.data.tags ?? []).join(', ')}
  canonical={`${siteConfig.url}/services/${entry.data.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div style="padding-top: 4.5rem;">

    <!-- Back nav -->
    <div style="background: hsl(220 40% 5%); border-bottom: 1px solid hsl(38 80% 55% / 0.12); padding: 1rem 0;">
      <div class="container-custom">
        <a
          href="/services"
          style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: hsl(210 15% 50%); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;"
        >
          ← All Services
        </a>
      </div>
    </div>

    <!-- Hero -->
    <section style="padding: 5rem 0 4rem; background: linear-gradient(180deg, hsl(220 40% 5%) 0%, var(--page-bg) 100%); border-bottom: 1px solid hsl(38 80% 55% / 0.12); position: relative; overflow: hidden;">
      <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 70% 60% at 50% 0%, hsl(38 80% 55% / 0.05), transparent); pointer-events: none;"></div>
      <div class="container-custom" style="max-width: 860px; position: relative;">

        <p style="font-family: monospace; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: hsl(38 80% 55%); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem;">
          <span style="display: block; width: 2rem; height: 1px; background: hsl(38 80% 55%);"></span>
          Service
        </p>

        <h1 style="font-family: var(--font-heading, 'Playfair Display', serif); font-size: clamp(2.25rem, 5vw, 3.5rem); font-weight: 700; color: hsl(45 30% 92%); margin: 0 0 1rem; line-height: 1.1;">
          {entry.data.title}
        </h1>
        <p style="font-size: 1.15rem; color: hsl(38 80% 55%); font-style: italic; margin: 0 0 1.5rem;">
          {entry.data.tagline}
        </p>
        <p style="color: hsl(210 15% 60%); font-size: 1rem; line-height: 1.75; margin: 0 0 2.5rem; max-width: 600px;">
          {entry.data.description}
        </p>

        <!-- Stat + CTA row -->
        <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: center;">
          {entry.data.heroStat && (
            <div style="padding: 1.25rem 2rem; background: hsl(220 40% 8%); border: 1px solid hsl(38 80% 55% / 0.2); border-radius: 6px; text-align: center;">
              <div style="font-family: var(--font-heading, serif); font-size: 2.5rem; font-weight: 700; color: hsl(38 80% 55%); line-height: 1;">{entry.data.heroStat}</div>
              <div style="font-size: 0.75rem; color: hsl(210 15% 55%); margin-top: 0.25rem;">{entry.data.heroStatLabel}</div>
            </div>
          )}
          <a
            href="/contact"
            style="display: inline-block; background: hsl(38 80% 55%); color: hsl(220 40% 8%); padding: 0.875rem 2rem; border-radius: 4px; font-weight: 700; font-size: 0.875rem; text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase;"
          >
            Start a Conversation
          </a>
          <a
            href="/case-studies"
            style="display: inline-block; border: 1px solid hsl(38 80% 55% / 0.4); color: hsl(38 80% 55%); padding: 0.875rem 2rem; border-radius: 4px; font-size: 0.875rem; text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600;"
          >
            View Case Studies
          </a>
        </div>
      </div>
    </section>

    <!-- Service Content -->
    <article class="container-custom svc-prose" style="max-width: 780px; padding-top: 4rem; padding-bottom: 5rem;">

      <!-- TL;DR -->
      <div
        style="
          background-color: var(--surface-1);
          border-left: 3px solid var(--accent);
          padding: 1.5rem;
          margin-bottom: 2.5rem;
          border-radius: 0 var(--border-radius) var(--border-radius) 0;
        "
      >
        <p
          style="
            font-size: 0.8rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--accent);
            font-weight: 600;
            margin: 0 0 0.75rem;
          "
        >
          TL;DR
        </p>
        <ul style="margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <li style="color: var(--text-secondary); font-size: 1.125rem; line-height: 1.6;">{entry.data.tagline}</li>
          <li style="color: var(--text-secondary); font-size: 1.125rem; line-height: 1.6;">{entry.data.tags?.length > 0 ? `Key areas: ${entry.data.tags?.slice(0, 4).join(', ')}` : ''}</li>
          {entry.data.heroStat && (
            <li style="color: var(--text-secondary); font-size: 1.125rem; line-height: 1.6;">Average client impact: {entry.data.heroStat} {entry.data.heroStatLabel}</li>
          )}
        </ul>
      </div>

      <Content />

      <!-- CTA -->
      <div style="margin-top: 4rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div style="padding: 2rem; background: hsl(220 40% 7%); border: 1px solid hsl(38 80% 55% / 0.2); border-radius: 8px;">
          <p style="font-family: monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: hsl(38 80% 55%); margin-bottom: 0.75rem;">Get Started</p>
          <h3 style="font-family: var(--font-heading, serif); font-size: 1.2rem; font-weight: 700; color: hsl(45 30% 92%); margin: 0 0 1rem;">Ready to Engage?</h3>
          <a href="/contact" style="display: inline-block; background: hsl(38 80% 55%); color: hsl(220 40% 8%); padding: 0.625rem 1.5rem; border-radius: 4px; font-weight: 700; font-size: 0.8rem; text-decoration: none; letter-spacing: 0.06em; text-transform: uppercase;">Contact Us</a>
        </div>
        <div style="padding: 2rem; background: hsl(220 40% 7%); border: 1px solid hsl(220 40% 14%); border-radius: 8px;">
          <p style="font-family: monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: hsl(210 15% 40%); margin-bottom: 0.75rem;">See the Work</p>
          <h3 style="font-family: var(--font-heading, serif); font-size: 1.2rem; font-weight: 700; color: hsl(45 30% 92%); margin: 0 0 1rem;">Case Studies</h3>
          <a href="/case-studies" style="display: inline-block; border: 1px solid hsl(210 15% 30%); color: hsl(210 15% 65%); padding: 0.625rem 1.5rem; border-radius: 4px; font-size: 0.8rem; text-decoration: none; letter-spacing: 0.06em; text-transform: uppercase;">View Results</a>
        </div>
      </div>
    </article>
  </div>

  <style>
    @media (max-width: 640px) {
      .svc-prose + div > div { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
