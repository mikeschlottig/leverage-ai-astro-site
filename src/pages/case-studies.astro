---
// ============================================================
// CASE STUDIES — Leverage AI LLC
// Sections: page hero, case study grid, featured card, CaseStudySection
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudySection from '../components/CaseStudySection';
import { getCollection } from 'astro:content';
import { siteConfig, metricsConfig, portfolioConfig } from '../lib/site-config';

const allCaseStudies = await getCollection('caseStudies');
const caseStudies = allCaseStudies.sort((a, b) => a.data.order - b.data.order);

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${siteConfig.url}/case-studies` },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Case Studies | Leverage AI',
  url: `${siteConfig.url}/case-studies`,
  mainEntity: caseStudies.map(s => ({ '@type': 'CreativeWork', name: s.data.title, url: `${siteConfig.url}/case-studies/${s.id}` })),
};
---

<BaseLayout
  title="Case Studies | Leverage AI"
  description="Explore how Leverage AI has delivered measurable AI search visibility and design results for clients across industries."
  keywords="AI search case studies, GEO results, brand visibility, digital strategy results, Portland Oregon"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <!-- ─── Page Hero ──────────────────────────────────────────── -->
  <section
    style="
      padding-top: 10rem;
      padding-bottom: 5rem;
      background-color: var(--page-bg);
      position: relative;
      overflow: hidden;
    "
  >
    <div style="position:absolute; top:-5%; left:-5%; width:700px; height:500px; background:radial-gradient(ellipse, rgba(212,144,15,0.05) 0%, transparent 70%); pointer-events:none;" />
    <div class="container-custom" style="position: relative; z-index: 1; max-width: 800px;">
      <p class="eyebrow" style="margin-bottom: 1rem;">Our Work</p>
      <h1
        style="
          font-family: var(--font-heading);
          font-size: clamp(2.8rem, 6vw, 5rem);
          font-weight: 300;
          line-height: 1.1;
          color: var(--text-primary);
          margin: 0 0 1.5rem;
        "
      >
        Case Studies
      </h1>
      <p style="font-size: 1.1rem; color: var(--text-secondary); line-height: 1.7; max-width: 560px; margin: 0;">
        Every number represents a real brand transformation. Here is how we do it.
      </p>
    </div>
  </section>

  <!-- ─── Case Studies Grid ──────────────────────────────────── -->
  {caseStudies.length > 0 && (
    <section class="section-padding" style="background-color: var(--surface-1);">
      <div class="container-custom">
        <div
          style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
          "
          class="case-grid"
        >
          {caseStudies.map((study) => (
            <article
              class="glass fade-up premium-hover"
              style="
                border-radius: var(--border-radius);
                border: 1px solid var(--border-subtle);
                overflow: hidden;
                display: flex;
                flex-direction: column;
              "
            >
              <!-- Image placeholder -->
              <div
                style="
                  aspect-ratio: 16/9;
                  background-color: var(--surface-2);
                  overflow: hidden;
                  position: relative;
                "
              >
                {study.data.image ? (
                  <img
                    src={study.data.image}
                    alt={study.data.title}
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  />
                ) : (
                  <div
                    style="
                      width: 100%;
                      height: 100%;
                      display: flex;
                      align-items: center;
                      justify-content: center;
                      background: linear-gradient(135deg, var(--surface-2) 0%, var(--surface-1) 100%);
                    "
                  >
                    <span style="font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-muted);">
                      {study.data.industry}
                    </span>
                  </div>
                )}
                {study.data.featured && (
                  <div
                    style="
                      position: absolute;
                      top: 0.75rem;
                      left: 0.75rem;
                      font-size: 0.6rem;
                      letter-spacing: 0.15em;
                      text-transform: uppercase;
                      background: var(--accent);
                      color: #0d1119;
                      padding: 0.2rem 0.6rem;
                      border-radius: 999px;
                      font-weight: 600;
                    "
                  >
                    Featured
                  </div>
                )}
              </div>

              <!-- Content -->
              <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 0.75rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem;">
                  <span style="font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);">
                    {study.data.industry}
                  </span>
                  {study.data.date && (
                    <span style="font-size: 0.65rem; color: var(--text-muted); flex-shrink: 0;">
                      {new Date(study.data.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                    </span>
                  )}
                </div>

                <h2
                  style="
                    font-family: var(--font-heading);
                    font-size: 1.25rem;
                    font-weight: 300;
                    color: var(--text-primary);
                    margin: 0;
                    line-height: 1.3;
                  "
                >
                  {study.data.title}
                </h2>

                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">
                  {study.data.client}
                </p>

                <!-- Results highlight -->
                <div
                  style="
                    background-color: var(--surface-2);
                    border-left: 2px solid var(--accent);
                    padding: 0.75rem 1rem;
                    border-radius: 0 calc(var(--border-radius) / 2) calc(var(--border-radius) / 2) 0;
                    margin-top: 0.25rem;
                  "
                >
                  <p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                    {study.data.results.primary}
                  </p>
                  {study.data.results.secondary && (
                    <p style="font-size: 0.78rem; color: var(--text-muted); margin: 0.4rem 0 0; line-height: 1.5;">
                      {study.data.results.secondary}
                    </p>
                  )}
                </div>

                <!-- Service tags -->
                <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem;">
                  {study.data.services.map((svc) => (
                    <span
                      style="
                        padding: 0.2rem 0.6rem;
                        font-size: 0.65rem;
                        letter-spacing: 0.08em;
                        text-transform: uppercase;
                        border: 1px solid var(--border-subtle);
                        border-radius: 999px;
                        color: var(--text-muted);
                      "
                    >
                      {svc}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── Featured Case Study (from metricsConfig) ───────────── -->
  <section id="enterprise" class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <div
        class="glass fade-up"
        style="
          padding: 3rem;
          border-radius: var(--border-radius);
          border: 1px solid var(--border-accent);
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 3rem;
          align-items: center;
          background: linear-gradient(135deg, var(--surface-1) 0%, var(--surface-2) 100%);
        "
      >
        <div>
          <p
            style="
              font-size: 0.65rem;
              letter-spacing: 0.2em;
              text-transform: uppercase;
              color: var(--accent);
              margin: 0 0 1rem;
            "
          >
            {metricsConfig.featuredCaseStudy.eyebrow}
          </p>
          <h2
            style="
              font-family: var(--font-heading);
              font-size: clamp(1.5rem, 3vw, 2.25rem);
              font-weight: 300;
              color: var(--text-primary);
              margin: 0 0 1.25rem;
              line-height: 1.2;
            "
          >
            {metricsConfig.featuredCaseStudy.title}
          </h2>
          <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.75; margin: 0 0 1.75rem;">
            {metricsConfig.featuredCaseStudy.description}
          </p>
          <a href={metricsConfig.featuredCaseStudy.href} class="btn-primary" style="font-size: 0.8rem;">
            Read Full Case Study
          </a>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {metricsConfig.featuredCaseStudy.tags.map((tag) => (
            <div
              style="
                padding: 1rem 1.25rem;
                background-color: var(--surface-1);
                border: 1px solid var(--border-subtle);
                border-radius: var(--border-radius);
                font-size: 0.8rem;
                color: var(--text-secondary);
                display: flex;
                align-items: center;
                gap: 0.75rem;
              "
            >
              <span style="color: var(--accent); font-size: 1rem;">&#10003;</span>
              {tag}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Portfolio & Live Applications ────────────────────── -->
  <section id="portfolio" class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">

      <div style="margin-bottom: 3rem;">
        <p class="eyebrow" style="margin-bottom: 0.75rem;">{portfolioConfig.eyebrow}</p>
        <h2
          style="
            font-family: var(--font-heading);
            font-size: clamp(1.8rem, 3.5vw, 2.75rem);
            font-weight: 300;
            color: var(--text-primary);
            margin: 0 0 1rem;
          "
        >
          {portfolioConfig.headline}
        </h2>
        <p style="color: var(--text-secondary); font-size: 0.9rem; max-width: 560px; line-height: 1.7; margin: 0;">
          Live client work, interactive tools, and web apps — each built with AI visibility and conversion as the primary objectives.
        </p>
      </div>

      <div
        style="
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
          gap: 1.5rem;
        "
        class="portfolio-grid"
      >
        {portfolioConfig.items.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="glass fade-up portfolio-card"
            style="
              border-radius: var(--border-radius);
              border: 1px solid var(--border-subtle);
              overflow: hidden;
              display: flex;
              flex-direction: column;
              text-decoration: none;
              transition: border-color 0.25s ease, transform 0.25s ease;
              cursor: pointer;
            "
          >
            <!-- Image / Thumbnail -->
            <div
              style="
                aspect-ratio: 16/9;
                background-color: var(--surface-2);
                overflow: hidden;
                position: relative;
              "
            >
              {item.image ? (
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                />
              ) : (
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--surface-2),var(--surface-1));">
                  <span style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--text-muted);">{item.type}</span>
                </div>
              )}
              <!-- Badge top-left -->
              <div
                style="
                  position: absolute;
                  top: 0.75rem;
                  left: 0.75rem;
                  font-size: 0.6rem;
                  letter-spacing: 0.15em;
                  text-transform: uppercase;
                  background: var(--surface-2);
                  border: 1px solid var(--border-accent);
                  color: var(--accent);
                  padding: 0.2rem 0.6rem;
                  border-radius: 999px;
                  font-weight: 600;
                "
              >
                {item.badge}
              </div>
              <!-- Status badge top-right -->
              {item.status === 'coming-soon' ? (
                <div
                  style="
                    position: absolute;
                    top: 0.75rem;
                    right: 0.75rem;
                    font-size: 0.6rem;
                    letter-spacing: 0.12em;
                    text-transform: uppercase;
                    background: rgba(0,0,0,0.6);
                    color: var(--text-muted);
                    padding: 0.2rem 0.6rem;
                    border-radius: 999px;
                    backdrop-filter: blur(4px);
                  "
                >
                  Coming Soon
                </div>
              ) : (
                <div
                  style="
                    position: absolute;
                    top: 0.75rem;
                    right: 0.75rem;
                    font-size: 0.6rem;
                    letter-spacing: 0.12em;
                    text-transform: uppercase;
                    background: rgba(16, 140, 64, 0.85);
                    color: #fff;
                    padding: 0.2rem 0.6rem;
                    border-radius: 999px;
                    backdrop-filter: blur(4px);
                  "
                >
                  Live ↗
                </div>
              )}
            </div>

            <!-- Content -->
            <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 0.6rem;">
              <h3
                style="
                  font-family: var(--font-heading);
                  font-size: 1.15rem;
                  font-weight: 300;
                  color: var(--text-primary);
                  margin: 0;
                  line-height: 1.3;
                "
              >
                {item.title}
              </h3>
              <p style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.65; margin: 0; flex: 1;">
                {item.description}
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.25rem;">
                {item.tags.map((tag) => (
                  <span
                    style="
                      padding: 0.18rem 0.55rem;
                      font-size: 0.62rem;
                      letter-spacing: 0.08em;
                      text-transform: uppercase;
                      border: 1px solid var(--border-subtle);
                      border-radius: 999px;
                      color: var(--text-muted);
                    "
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── Metrics / CaseStudy React Island ──────────────────── -->
  <CaseStudySection client:visible />

</BaseLayout>

<style>
  @media (max-width: 900px) {
    .case-grid      { grid-template-columns: 1fr 1fr !important; }
    .portfolio-grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 600px) {
    .case-grid      { grid-template-columns: 1fr !important; }
    .portfolio-grid { grid-template-columns: 1fr !important; }
    .glass[id="enterprise"] { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
  }
  .portfolio-card:hover {
    border-color: var(--border-accent) !important;
    transform: translateY(-2px);
  }
  .portfolio-card:hover img {
    transform: scale(1.03);
  }
  .glass[style*="grid-template-columns: 1fr 1fr"] {
    /* featured card responsive handled via inline style override */
  }
  @media (max-width: 767px) {
    section[id="enterprise"] .glass { grid-template-columns: 1fr !important; }
  }
</style>
