---
// ============================================================
// BLOG INDEX — Leverage AI LLC
// Featured post hero card + all posts grid (3 col)
// ============================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../lib/site-config';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featured = posts.find(p => p.data.featured) ?? posts[0];
const rest = posts.filter(p => p.id !== featured?.id);

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteConfig.url}/blog` },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Blog | Leverage AI',
  description: 'Insights and analysis on AI search optimization, GEO strategy, brand visibility, and design intelligence.',
  url: `${siteConfig.url}/blog`,
  mainEntity: posts.map(p => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${siteConfig.url}/blog/${p.id}` })),
};
---

<BaseLayout
  title="Blog | Leverage AI"
  description="Insights and analysis on AI search optimization, GEO strategy, brand visibility, and design intelligence — from the LEVERAGE AI team."
  keywords="AI search blog, GEO strategy, generative engine optimization insights, AI visibility tips, brand strategy blog"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div style="padding-top: 4.5rem;">

    <!-- ─── Featured Post ──────────────────────────────────── -->
    {featured && (
      <section
        style="
          padding: 5rem 0 3rem;
          background-color: var(--surface-1);
          position: relative;
          overflow: hidden;
        "
      >
        <div style="position:absolute; inset:0; background:radial-gradient(ellipse at 30% 50%, rgba(212,144,15,0.04) 0%, transparent 65%); pointer-events:none;" />
        <div class="container-custom" style="position: relative; z-index: 1;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem;">
            <p class="eyebrow" style="margin: 0;">Featured Post</p>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;" class="featured-grid">
            <!-- Image -->
            <div style="border-radius: var(--border-radius); overflow: hidden; aspect-ratio: 4/3; background-color: var(--surface-2);">
              {featured.data.image ? (
                <img
                  src={featured.data.image}
                  alt={featured.data.title}
                  style="width: 100%; height: 100%; object-fit: cover;"
                  loading="eager"
                />
              ) : (
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--surface-2);">
                  <span style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--text-muted);">{featured.data.category}</span>
                </div>
              )}
            </div>

            <!-- Content -->
            <div>
              <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem;">
                <span style="font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent);">
                  {featured.data.category}
                </span>
                {featured.data.readingTime && (
                  <span style="font-size: 0.7rem; color: var(--text-muted);">{featured.data.readingTime}</span>
                )}
                <span style="font-size: 0.7rem; color: var(--text-muted);">
                  {new Date(featured.data.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
                </span>
              </div>

              <h1
                style="
                  font-family: var(--font-heading);
                  font-size: clamp(1.8rem, 3.5vw, 3rem);
                  font-weight: 300;
                  margin: 0 0 1rem;
                  line-height: 1.2;
                  color: var(--text-primary);
                "
              >
                {featured.data.title}
              </h1>

              {featured.data.tldr && featured.data.tldr.length > 0 && (
                <div
                  style="
                    background-color: var(--surface-2);
                    border-left: 3px solid var(--accent);
                    padding: 1rem 1.25rem;
                    margin-bottom: 1.25rem;
                    border-radius: 0 var(--border-radius) var(--border-radius) 0;
                  "
                >
                  <p style="font-size: 0.8rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.5rem;">
                    TL;DR
                  </p>
                  <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-secondary); font-size: 1.125rem; line-height: 1.6;">
                    {featured.data.tldr.map((point: string) => <li>{point}</li>)}
                  </ul>
                </div>
              )}

              <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem; font-size: 0.95rem;">
                {featured.data.excerpt}
              </p>

              <a href={`/blog/${featured.id}`} class="btn-primary" style="font-size: 0.8rem;">
                Read Article
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ─── All Posts Grid ─────────────────────────────────── -->
    <section class="section-padding" style="background-color: var(--page-bg);">
      <div class="container-custom">
        <h2
          style="
            font-family: var(--font-heading);
            font-size: clamp(1.5rem, 3vw, 2rem);
            font-weight: 300;
            margin: 0 0 2.5rem;
            color: var(--text-primary);
          "
        >
          {rest.length > 0 ? 'All Posts' : 'More Coming Soon'}
        </h2>

        {rest.length > 0 && (
          <div
            style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;"
            class="posts-grid"
          >
            {rest.map((post) => (
              <article
                class="fade-up"
                style="
                  background-color: var(--surface-1);
                  border: 1px solid var(--border-subtle);
                  border-radius: var(--border-radius);
                  overflow: hidden;
                  display: flex;
                  flex-direction: column;
                  transition: border-color 0.25s ease;
                "
              >
                <div style="aspect-ratio: 16/9; overflow: hidden; background-color: var(--surface-2);">
                  {post.data.image ? (
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      loading="lazy"
                      style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                    />
                  ) : (
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--surface-2);">
                      <span style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--text-muted);">{post.data.category}</span>
                    </div>
                  )}
                </div>
                <div style="padding: 1.25rem; flex: 1; display: flex; flex-direction: column; gap: 0.5rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);">
                      {post.data.category}
                    </span>
                    {post.data.readingTime && (
                      <span style="font-size: 0.7rem; color: var(--text-muted);">{post.data.readingTime}</span>
                    )}
                  </div>
                  <h3
                    style="
                      font-family: var(--font-heading);
                      font-size: 1.2rem;
                      font-weight: 300;
                      margin: 0;
                      line-height: 1.3;
                      color: var(--text-primary);
                    "
                  >
                    {post.data.title}
                  </h3>
                  <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; flex: 1; margin: 0;">
                    {post.data.excerpt}
                  </p>
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
                    <a
                      href={`/blog/${post.id}`}
                      style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);"
                    >
                      Read More &rarr;
                    </a>
                    <span style="font-size: 0.65rem; color: var(--text-muted);">
                      {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}

        <!-- Research CTA -->
        <div
          style="
            margin-top: 3rem;
            padding: 2.5rem;
            background-color: var(--surface-1);
            border: 1px solid var(--border-accent);
            border-radius: var(--border-radius);
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2rem;
            align-items: center;
          "
          class="research-cta"
        >
          <div>
            <p class="eyebrow" style="margin-bottom: 0.5rem;">Deep Dive</p>
            <h3
              style="
                font-family: var(--font-heading);
                font-size: 1.5rem;
                font-weight: 300;
                margin: 0 0 0.5rem;
                color: var(--text-primary);
              "
            >
              AI Search Visibility Report 2025
            </h3>
            <p style="color: var(--text-secondary); font-size: 0.875rem; margin: 0;">
              Our in-depth analysis of how AI models discover, rank, and cite brands in generative search.
            </p>
          </div>
          <a href="/research" class="btn-primary" style="white-space: nowrap; font-size: 0.8rem;">
            View Report
          </a>
        </div>
      </div>
    </section>

  </div>

</BaseLayout>

<style>
  .featured-grid { grid-template-columns: 1fr 1fr; }
  @media (max-width: 900px) {
    .featured-grid { grid-template-columns: 1fr !important; }
    .posts-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 600px) {
    .posts-grid { grid-template-columns: 1fr !important; }
    .research-cta { grid-template-columns: 1fr !important; }
  }
</style>
