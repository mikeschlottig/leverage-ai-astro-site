---
// ============================================================
// SERVICES — Leverage AI LLC
// Page hero + ServicesSection React island (client:visible)
// followed by detailed anchor-linked service cards.
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesSection from '../components/ServicesSection';
import { siteConfig, servicesConfig } from '../lib/site-config';

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteConfig.url}/services` },
  ],
};
---

<section
    style="
      padding-top: 10rem;
      padding-bottom: 5rem;
      background-color: var(--page-bg);
      position: relative;
      overflow: hidden;
    "
  >
    <div style="position:absolute; top:-10%; right:-5%; width:600px; height:600px; background:radial-gradient(ellipse, rgba(212,144,15,0.05) 0%, transparent 70%); pointer-events:none;" />
    <div class="container-custom" style="position: relative; z-index: 1; max-width: 800px;">
      <p class="eyebrow" style="margin-bottom: 1rem;">{servicesConfig.eyebrow}</p>
      <h1
        style="
          font-family: var(--font-heading);
          font-size: clamp(2.8rem, 6vw, 5rem);
          font-weight: 300;
          line-height: 1.1;
          color: var(--text-primary);
          margin: 0 0 1.5rem;
        "
      >
        {servicesConfig.headline}
      </h1>
      <p
        style="
          font-size: 1.1rem;
          color: var(--text-secondary);
          line-height: 1.7;
          max-width: 560px;
          margin: 0;
        "
      >
        {servicesConfig.subheadline}
      </p>
    </div>
  </section>

  <!-- ─── Services Section (React island) ───────────────────── -->
  <ServicesSection client:visible />

  <!-- ─── Detailed Service Cards ────────────────────────────── -->
  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom">
      <p class="eyebrow" style="margin-bottom: 0.75rem; text-align: center;">Deep Dive</p>
      <h2
        style="
          font-family: var(--font-heading);
          font-size: clamp(1.8rem, 3.5vw, 2.75rem);
          font-weight: 300;
          color: var(--text-primary);
          margin: 0 0 3rem;
          text-align: center;
        "
      >
        Service Details
      </h2>

      <div style="display: flex; flex-direction: column; gap: 2rem;">
        {servicesConfig.services.map((service) => (
          <div
            id={service.id}
            class="glass fade-up"
            style="
              padding: 2.5rem;
              border-radius: var(--border-radius);
              border: 1px solid var(--border-subtle);
              display: grid;
              grid-template-columns: 1fr 1fr;
              gap: 3rem;
              align-items: start;
            "
          >
            <!-- Left: title + description -->
            <div>
              <div
                style="
                  display: inline-flex;
                  align-items: center;
                  gap: 0.5rem;
                  font-size: 0.65rem;
                  letter-spacing: 0.15em;
                  text-transform: uppercase;
                  color: var(--accent);
                  margin-bottom: 1rem;
                  padding: 0.3rem 0.75rem;
                  border: 1px solid var(--border-accent);
                  border-radius: 999px;
                "
              >
                {service.icon}
              </div>
              <h3
                style="
                  font-family: var(--font-heading);
                  font-size: clamp(1.4rem, 2.5vw, 2rem);
                  font-weight: 300;
                  color: var(--text-primary);
                  margin: 0 0 1rem;
                "
              >
                {service.title}
              </h3>
              <p style="color: var(--text-secondary); line-height: 1.7; margin: 0; font-size: 0.95rem;">
                {service.description}
              </p>
            </div>

            <!-- Right: details list -->
            <div>
              <p
                style="
                  font-size: 0.7rem;
                  letter-spacing: 0.15em;
                  text-transform: uppercase;
                  color: var(--text-muted);
                  margin: 0 0 1rem;
                "
              >
                What's Included
              </p>
              <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
                {service.details.map((detail) => (
                  <li
                    style="
                      display: flex;
                      align-items: flex-start;
                      gap: 0.75rem;
                      font-size: 0.9rem;
                      color: var(--text-secondary);
                      line-height: 1.5;
                      padding-bottom: 0.75rem;
                      border-bottom: 1px solid var(--border-subtle);
                    "
                  >
                    <span style="color: var(--accent); flex-shrink: 0; font-size: 1rem; margin-top: 1px;">&#8250;</span>
                    {detail}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA ────────────────────────────────────────────────── -->
  <section
    style="
      padding: 5rem 0;
      background-color: var(--surface-1);
      border-top: 1px solid var(--border-subtle);
    "
  >
    <div class="container-custom" style="text-align: center; max-width: 600px;">
      <p class="eyebrow" style="margin-bottom: 0.75rem;">Get Started</p>
      <h2
        style="
          font-family: var(--font-heading);
          font-size: clamp(1.8rem, 3.5vw, 2.75rem);
          font-weight: 300;
          color: var(--text-primary);
          margin: 0 0 1rem;
        "
      >
        Ready to Build Your AI Advantage?
      </h2>
      <p style="color: var(--text-secondary); margin: 0 0 2rem; line-height: 1.7;">
        Every engagement is custom-scoped. Let's talk about where your brand stands today and where it needs to be.
      </p>
      <a href="/contact" class="btn-primary">Request a Strategy Call</a>
    </div>
  </section>

</BaseLayout>

<style>
  @media (max-width: 767px) {
    .glass[id] { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
  }
</style>
