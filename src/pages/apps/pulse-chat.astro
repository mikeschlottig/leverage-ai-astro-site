---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PulseChat from '../../components/apps/PulseChat.tsx';
import { siteConfig } from '../../lib/site-config';

const appName = 'Pulse Chat';
const appDescription = 'Sleek AI chat interface with multi-model support, session persistence, and real-time streaming responses for next-generation conversational AI.';

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${siteConfig.url}/catalog` },
    { '@type': 'ListItem', position: 3, name: appName, item: `${siteConfig.url}/apps/pulse-chat` },
  ],
};
const appSchema = {
  '@context': 'https://schema.org', '@type': 'WebApplication',
  name: appName, description: appDescription, applicationCategory: 'CommunicationApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'Leverage AI LLC', url: siteConfig.url },
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is Pulse Chat?', acceptedAnswer: { '@type': 'Answer', text: 'Pulse Chat is a modern AI chat interface supporting multiple language models with session persistence, real-time streaming responses, and a clean, distraction-free user experience.' } },
    { '@type': 'Question', name: 'Which AI models does Pulse Chat support?', acceptedAnswer: { '@type': 'Answer', text: 'Pulse Chat supports multiple LLM providers and models, configurable through its interface. Session history is persisted locally for seamless continuation.' } },
  ],
};
---

<BaseLayout title={`${appName} | Web App — Leverage AI`} description={appDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section style="padding: 6rem 0 3rem; background: linear-gradient(180deg, hsl(220 40% 5%) 0%, var(--page-bg) 100%); border-bottom: 1px solid hsl(38 80% 55% / 0.12);">
    <div class="container-custom" style="max-width: 800px;">
      <a href="/catalog" style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: hsl(210 15% 50%); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">&larr; All Apps</a>
      <h1 style="font-family: var(--font-heading); font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 700; color: hsl(45 30% 92%); margin: 0 0 1rem; line-height: 1.1;">{appName}</h1>
      <p style="color: hsl(210 15% 60%); font-size: 1.05rem; line-height: 1.7; max-width: 600px; margin: 0;">{appDescription}</p>
    </div>
  </section>
  <section style="padding: 0; background: var(--page-bg);"><PulseChat client:only="react" /></section>

  <section class="section-padding" style="background-color: var(--surface-1); border-top: 1px solid var(--border-subtle);">
    <div class="container-custom" style="max-width: 720px;">
      <h2 style="font-family: var(--font-heading); font-size: 1.75rem; font-weight: 300; color: var(--text-primary); margin: 0 0 2rem;">Frequently Asked Questions</h2>
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div style="padding: 1.25rem; background: var(--surface-2); border-radius: var(--border-radius); border: 1px solid var(--border-subtle);">
          <h3 style="font-family: var(--font-heading); font-size: 1.1rem; font-weight: 400; color: var(--text-primary); margin: 0 0 0.5rem;">What is Pulse Chat?</h3>
          <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.65; margin: 0;">Pulse Chat is a modern AI chat interface supporting multiple language models with session persistence, real-time streaming responses, and a clean, distraction-free user experience.</p>
        </div>
        <div style="padding: 1.25rem; background: var(--surface-2); border-radius: var(--border-radius); border: 1px solid var(--border-subtle);">
          <h3 style="font-family: var(--font-heading); font-size: 1.1rem; font-weight: 400; color: var(--text-primary); margin: 0 0 0.5rem;">Which AI models does Pulse Chat support?</h3>
          <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.65; margin: 0;">Pulse Chat supports multiple LLM providers and models, configurable through its interface. Session history is persisted locally for seamless continuation.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
