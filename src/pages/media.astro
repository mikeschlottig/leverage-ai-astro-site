---
// ============================================================
// MEDIA — Leverage AI LLC
// Media room: audio player with track(s), future expansion ready
// ============================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPlayer from '../components/MediaPlayer';
import { siteConfig } from '../lib/site-config';

// PODCAST FILE: Place the real MP3 at:
//   public/media/AI_and_the_Oregon_I-5_hotel_crisis.mp3
// The current file is a silent placeholder. Replace it with the real audio.
const tracks = [
  {
    title: 'AI and the Oregon I-5 Hotel Crisis',
    artist: 'LEVERAGE AI — Media Room',
    src: '/media/AI_and_the_Oregon_I-5_hotel_crisis.mp3',
    type: 'audio' as const,
  },
];

const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
    { '@type': 'ListItem', position: 2, name: 'Media', item: `${siteConfig.url}/media` },
  ],
};

---

<BaseLayout
  title="Media & Insights | Leverage AI"
  description="The LEVERAGE AI Media Room — audio insights, interviews, and analysis on AI search, digital strategy, and brand visibility."
  keywords="AI search podcast, digital strategy audio, GEO insights, AI visibility media, Leverage AI media room"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <!-- ─── Page Hero ──────────────────────────────────────────── -->
  <section
    style="
      padding-top: 10rem;
      padding-bottom: 5rem;
      background-color: var(--page-bg);
      position: relative;
      overflow: hidden;
      text-align: center;
    "
  >
    <div style="position:absolute; top:-10%; left:50%; transform:translateX(-50%); width:800px; height:500px; background:radial-gradient(ellipse, rgba(212,144,15,0.06) 0%, transparent 70%); pointer-events:none;" />
    <div class="container-custom" style="position: relative; z-index: 1; max-width: 700px; margin: 0 auto;">
      <p class="eyebrow" style="margin-bottom: 1rem;">Media &amp; Insights</p>
      <h1
        style="
          font-family: var(--font-heading);
          font-size: clamp(2.5rem, 5.5vw, 4.5rem);
          font-weight: 300;
          line-height: 1.1;
          color: var(--text-primary);
          margin: 0 0 1.5rem;
        "
      >
        The LEVERAGE AI<br />
        <span style="color: var(--accent);">Media Room</span>
      </h1>
      <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.7; max-width: 500px; margin: 0 auto;">
        Audio insights, interviews, and analysis at the intersection of AI, search visibility, and digital strategy.
      </p>
    </div>
  </section>

  <!-- ─── Featured Audio Player ─────────────────────────────── -->
  <section class="section-padding" style="background-color: var(--surface-1);">
    <div class="container-custom" style="max-width: 780px; margin: 0 auto;">
      <div style="margin-bottom: 2rem;">
        <p
          style="
            font-size: 0.65rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--accent);
            margin: 0 0 0.5rem;
          "
        >
          Latest Episode
        </p>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0;">
          Press play to listen in your browser. No app required.
        </p>
      </div>

      <!-- React island: MediaPlayer -->
      <MediaPlayer client:load tracks={tracks} />
    </div>
  </section>

  <!-- ─── About the Episode ──────────────────────────────────── -->
  <section class="section-padding" style="background-color: var(--page-bg);">
    <div class="container-custom" style="max-width: 780px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start;" class="episode-grid">
      <div>
        <p class="eyebrow" style="margin-bottom: 0.75rem;">About This Episode</p>
        <h2
          style="
            font-family: var(--font-heading);
            font-size: clamp(1.5rem, 2.5vw, 2rem);
            font-weight: 300;
            color: var(--text-primary);
            margin: 0 0 1rem;
            line-height: 1.3;
          "
        >
          AI and the Oregon I-5 Hotel Crisis
        </h2>
        <p style="color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; font-size: 0.9rem;">
          An exploration of how AI-generated search results shaped public perception and response during a high-stakes regional crisis — and what brands can learn from the event about visibility, narrative control, and AI search optimization.
        </p>
        <p style="color: var(--text-secondary); line-height: 1.75; margin: 0; font-size: 0.9rem;">
          This case highlights why proactive AI search strategy is no longer optional for organizations operating in high-scrutiny environments.
        </p>
      </div>
      <div>
        <p
          style="
            font-size: 0.65rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 0 0 1rem;
          "
        >
          Topics Covered
        </p>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem;">
          {[
            'AI search citation patterns during crises',
            'How AI models surface conflicting narratives',
            'Brand visibility in Perplexity and ChatGPT',
            'Structured data as a trust signal',
            'Proactive GEO strategy for high-stakes sectors',
          ].map((topic) => (
            <li style="display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.85rem; color: var(--text-secondary);">
              <span style="color: var(--accent); flex-shrink: 0; margin-top: 2px;">&#8250;</span>
              {topic}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── More Media CTA ─────────────────────────────────────── -->
  <section
    style="
      padding: 4rem 0;
      background-color: var(--surface-1);
      border-top: 1px solid var(--border-subtle);
    "
  >
    <div class="container-custom" style="text-align: center; max-width: 560px;">
      <p style="color: var(--text-secondary); margin: 0 0 1.5rem; font-size: 0.95rem; line-height: 1.6;">
        Want to be notified when new episodes and insights are published?
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn-primary">Stay in the Loop</a>
        <a href="/blog" class="btn-secondary">Read Our Insights</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  @media (max-width: 767px) {
    .episode-grid { grid-template-columns: 1fr !important; gap: 2rem !important; }
  }
</style>
