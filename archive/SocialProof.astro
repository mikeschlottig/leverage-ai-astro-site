---
// ============================================================
// SOCIAL PROOF — Blog articles grid + Testimonials + Story snapshot
//
// Three sub-sections:
//   1. Blog grid (fetches from content collection, newest first)
//   2. Testimonials grid (fetches from content collection, sorted by order)
//   3. About snapshot (static from socialProofConfig)
//
// No React — uses Astro static rendering + vanilla JS scroll reveals.
// Config: socialProofConfig in site-config.ts
// ============================================================
import { getCollection } from 'astro:content';
import { socialProofConfig } from '../lib/site-config';

// Fetch blog posts (newest first, limit 4 for grid)
const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

// Fetch testimonials (sorted by order field)
const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order);
---

<!-- ─── 1. Blog Grid ─────────────────────────────────────── -->
<section id="blog-preview" class="section-padding" style="background-color: var(--page-bg);">
  <div class="container-custom">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:3rem; flex-wrap:wrap; gap:1rem;">
      <div>
        <p class="eyebrow" style="margin-bottom:0.5rem;">{socialProofConfig.blogEyebrow}</p>
        <h2 style="font-family:var(--font-heading); font-size:clamp(1.8rem,4vw,3rem); font-weight:300; margin:0;">
          {socialProofConfig.blogHeadline}
        </h2>
      </div>
      <a href="/blog" class="btn-secondary" style="font-size:0.8rem;">{socialProofConfig.viewAllText}</a>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1.5rem;">
      {posts.map((post) => (
        <article class="fade-up" style="background-color:var(--surface-1); border:1px solid var(--border-subtle); border-radius:var(--border-radius); overflow:hidden; display:flex; flex-direction:column;">
          {post.data.image && (
            <div style="aspect-ratio:16/9; overflow:hidden;">
              <img
                src={post.data.image}
                alt={post.data.title}
                loading="lazy"
                style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s ease;"
              />
            </div>
          )}
          <div style="padding:1.5rem; display:flex; flex-direction:column; flex:1;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
              <span style="font-size:0.65rem; letter-spacing:0.15em; text-transform:uppercase; color:var(--accent);">
                {post.data.category}
              </span>
              <span style="font-size:0.7rem; color:var(--text-muted);">
                {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </span>
            </div>
            <h3 style="font-family:var(--font-heading); font-size:1.25rem; font-weight:300; margin:0 0 0.75rem; line-height:1.3;">
              {post.data.title}
            </h3>
            <p style="font-size:0.875rem; color:var(--text-secondary); line-height:1.6; margin:0 0 1.25rem; flex:1;">
              {post.data.excerpt}
            </p>
            <a
              href={`/blog/${post.id}`}
              style="font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent); text-decoration:none;"
            >
              {socialProofConfig.readMoreText} →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ─── 2. Testimonials ──────────────────────────────────── -->
<section id="testimonials" class="section-padding" style="background-color:var(--surface-1);">
  <div class="container-custom">
    <div style="text-align:center; margin-bottom:3rem;">
      <p class="eyebrow" style="margin-bottom:0.5rem;">{socialProofConfig.testimonialsEyebrow}</p>
      <h2 style="font-family:var(--font-heading); font-size:clamp(1.8rem,4vw,3rem); font-weight:300; margin:0;">
        {socialProofConfig.testimonialsHeadline}
      </h2>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem;">
      {testimonials.map((t) => (
        <div class="fade-up" style="padding:2rem; background-color:var(--surface-2); border:1px solid var(--border-subtle); border-radius:var(--border-radius); display:flex; flex-direction:column; gap:1rem;">
          {/* Stars */}
          <div style="display:flex; gap:0.25rem;">
            {Array.from({ length: t.data.rating }).map((_, i) => (
              <span key={i} style="color:var(--accent); font-size:0.875rem;">★</span>
            ))}
          </div>
          {/* Quote mark */}
          <span style="font-size:3rem; font-family:var(--font-heading); color:var(--accent); opacity:0.3; line-height:1; margin-bottom:-0.5rem;">"</span>
          {/* Body from markdown */}
          <div style="font-size:0.9rem; color:var(--text-secondary); line-height:1.7; font-style:italic;">
            <t.render />
          </div>
          {/* Attribution */}
          <div style="margin-top:auto; padding-top:1rem; border-top:1px solid var(--border-subtle);">
            <p style="font-weight:600; font-size:0.875rem; margin:0 0 0.25rem; color:var(--text-primary);">{t.data.name}</p>
            <p style="font-size:0.75rem; color:var(--text-muted); margin:0;">{t.data.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── 3. About Snapshot ────────────────────────────────── -->
<section class="section-padding" style="background-color:var(--page-bg);">
  <div class="container-custom">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center;">

      {/* Left: Image */}
      <div class="slide-in-left" style="position:relative; border-radius:var(--border-radius); overflow:hidden;">
        <img
          src={socialProofConfig.storyImage}
          alt={socialProofConfig.storyImageCaption}
          loading="lazy"
          style="width:100%; aspect-ratio:4/3; object-fit:cover;"
        />
        {/* Quote overlay */}
        <div style="position:absolute; bottom:0; left:0; right:0; padding:1.5rem; background:linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);">
          <p style="font-family:var(--font-heading); font-size:1.1rem; font-style:italic; color:#fff; margin:0;">
            "{socialProofConfig.storyQuote}"
          </p>
        </div>
      </div>

      {/* Right: Text */}
      <div class="slide-in-right">
        <p class="eyebrow has-bar" style="margin-bottom:1rem;">{socialProofConfig.storyEyebrow}</p>
        <h2 style="font-family:var(--font-heading); font-size:clamp(1.8rem,3.5vw,2.8rem); font-weight:300; margin:0 0 1.5rem;">
          {socialProofConfig.storyHeadline}
        </h2>
        {socialProofConfig.storyParagraphs.map((para) => (
          <p style="color:var(--text-secondary); line-height:1.7; margin-bottom:1rem; font-size:0.95rem;">{para}</p>
        ))}
        {/* Stats */}
        <div style="display:flex; gap:2rem; margin-top:2rem; flex-wrap:wrap;">
          {socialProofConfig.storyStats.map((stat) => (
            <div>
              <p style="font-family:var(--font-heading); font-size:2rem; color:var(--accent); margin:0; font-weight:300;">{stat.value}</p>
              <p style="font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin:0.25rem 0 0;">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Scroll-reveal observer -->
<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.fade-up, .slide-in-left, .slide-in-right').forEach(el => observer.observe(el));
</script>

<style>
  @media (max-width: 767px) {
    #blog-preview .container-custom > div:last-child,
    section:last-of-type .container-custom > div {
      grid-template-columns: 1fr !important;
    }
  }
</style>
