{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "featured": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "category",
    "image",
    "url",
    "order"
  ]
}